rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Google accounts allowed to manage the site.
    // Keep in sync with ADMIN_EMAILS in src/lib/auth.ts
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['chuquangthangftu@gmail.com'];
    }

    function isString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    // Optional English version of an article
    function isValidTranslation(t) {
      return t is map
        && hasExactly(t, ['title', 'excerpt', 'body'])
        && isString(t.title, 300) && t.title.size() > 0
        && isString(t.excerpt, 2000)
        && t.body is string && t.body.size() > 0;
    }

    // Matches ArticleInput in src/lib/articles.ts
    function isValidArticle(data) {
      return data.keys().hasAll(['title', 'slug', 'excerpt', 'body', 'tags', 'authorName',
                                 'readTimeMinutes', 'featured', 'publishedAt'])
        && data.keys().hasOnly(['title', 'slug', 'excerpt', 'body', 'tags', 'authorName',
                                'readTimeMinutes', 'featured', 'publishedAt', 'en'])
        && (!('en' in data) || isValidTranslation(data.en))
        && isString(data.title, 300) && data.title.size() > 0
        && data.slug is string && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && isString(data.excerpt, 2000)
        && data.body is string && data.body.size() > 0
        && data.tags is list && data.tags.size() <= 20
        && isString(data.authorName, 100)
        && data.readTimeMinutes is number
        && data.featured is bool
        && data.publishedAt is timestamp;
    }

    // Matches LeadInput in src/lib/leads.ts
    function isValidLead(data) {
      return data.createdAt == request.time
        && isString(data.name, 200) && data.name.size() > 0
        && isString(data.email, 200) && data.email.matches('^[^@\\s]+@[^@\\s]+$')
        && isString(data.company, 200)
        && (
          (data.source == 'checklist'
            && hasExactly(data, ['source', 'name', 'email', 'company', 'role', 'createdAt'])
            && isString(data.role, 200))
          ||
          (data.source == 'services'
            && hasExactly(data, ['source', 'name', 'email', 'phone', 'company', 'serviceType', 'message', 'createdAt'])
            && isString(data.phone, 50)
            && isString(data.serviceType, 200)
            && isString(data.message, 5000))
        );
    }

    // Blog posts: anyone can read, only the admin publishes from /admin/blog
    match /articles/{articleId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidArticle(request.resource.data);
      allow delete: if isAdmin();
    }

    // Checklist / consulting forms: anyone can submit, only the admin can read
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, delete: if isAdmin();
    }
  }
}
